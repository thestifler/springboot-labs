# Variables requeridas para conectar a la base de datos.
#
# Definirlas en el entorno (no en este archivo):
#   export DB_USERNAME=...
#   export DB_PASSWORD=...
#
# Si no estan definidas, la aplicacion usa los valores por defecto
# definidos en src/main/resources/application.properties
# (H2 en memoria, usuario "sa", sin contrasena).

DB_URL=jdbc:h2:mem:testdb
DB_DRIVER=org.h2.Driver
DB_USERNAME=
DB_PASSWORD=
